---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import FormattedDate from "../components/FormattedDate.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import { getCollection } from "astro:content";
import WorldBackground from "../components/WorldBackground.astro";
import { stack, stackIcons } from "../stack";

const experiments = (await getCollection("experiments")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
).slice(0, 4);

const projects = (await getCollection("projects")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
).slice(0, 2);

// Each half of the marquee track must be wider than the viewport, so a short
// list repeats (the repeats are hidden when motion is reduced). Duration
// scales with length to keep the roll speed constant.
const stackItems = Array.from({ length: Math.ceil(14 / stack.length) }, () => stack).flat();
const stackDuration = `${stackItems.length * 3.2}s`;

// The bio lights up word by word, like a bulb that doesn't quite want to
// start. Each word gets a flicker pattern and a start delay; an inline script
// re-rolls both on every load, so these build-time values are the no-JS
// fallback.
const bio =
  "Full-stack software developer. I also made kreni.app, a live Zagreb " +
  "transit map with nearly 5k users in its first month, featured in " +
  "Večernji list. For fun, it's GPU graphics and compute, mostly shaders.";
const bioWords = bio.split(" ").map((word, i) => ({
  word,
  flicker: i === 9 ? "c" : i % 5 === 2 ? "a" : "b",
  delay: Math.round(80 + ((i * 263) % 640)),
}));
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body class="min-h-screen w-full bg-[#0a0d14] text-[#ece4d3] font-sans">
    <WorldBackground />
    <div class="grid-dot-overlay"></div>
    <div class="max-w-6xl mx-auto px-6 md:px-10 lg:px-16 relative z-[2]">
      <Header />

      <!-- Hero -->
      <section class="pt-10 pb-20 md:py-28">
        <p class="hud accent-text text-[11px] mb-6 flex items-center gap-2.5">
          <span class="inline-block w-1.5 h-1.5 rounded-full bg-[var(--site-accent)] cursor-blink"></span>
          Zagreb, HR
        </p>
        <h1 class="font-display font-semibold leading-[0.95] tracking-[0.04em]">
          <span class="text-[clamp(2.5rem,9vw,7rem)] text-white block">SOFTWARE</span>
          <span class="text-[clamp(2.5rem,9vw,7rem)] accent-text block">ENGINEER</span>
        </h1>
        <p class="hud text-[11px] md:text-xs text-[#a89c85] mt-6">
          React&nbsp;· Next.js&nbsp;· TypeScript&nbsp;· WebGL&nbsp;· WebGPU&nbsp;· GLSL
        </p>

        <!-- Phone width: keep a window clear for the background graphic, which
             centres itself on this gap (see WorldBackground). -->
        <div data-world-focus aria-hidden="true" class="h-[36svh] md:hidden"></div>

        <p id="hero-bio" class="text-base text-[#a89c85] md:mt-8 max-w-xl leading-relaxed">
          {bioWords.map(({ word, flicker, delay }) => (
            <><span class="flicker-word" data-flicker={flicker} style={`--delay:${delay}ms`}>{word}</span>{" "}</>
          ))}
        </p>
        <script is:inline>
          // Re-roll the flicker so each load lights up differently. Runs as
          // the parser reaches it, before the first paint.
          (() => {
            const words = document.querySelectorAll("#hero-bio .flicker-word");
            const stubborn = 1 + Math.floor(Math.random() * (words.length - 1));
            words.forEach((el, i) => {
              el.dataset.flicker = i === stubborn ? "c" : Math.random() < 0.2 ? "a" : "b";
              el.style.setProperty("--delay", `${Math.round(60 + Math.random() * 700)}ms`);
            });
          })();
        </script>

        <div class="flex flex-wrap gap-3 mt-10">
          <a href="/experiments" class="hud text-[11px] bg-[var(--site-accent)] text-[#0a0d14] font-bold px-4 py-2.5 rounded hover:bg-[#fbbf24] transition-colors">
            View experiments →
          </a>
          <a href="/projects" class="hud text-[11px] bg-[#15110b] border border-[#3a3122] text-[#ece4d3] px-4 py-2.5 rounded hover-accent-border hover-accent-text transition-colors">
            View projects →
          </a>
          <a href="https://github.com/aeoden96" target="_blank" class="hud text-[11px] bg-[#15110b] border border-[#3a3122] text-[#ece4d3] px-4 py-2.5 rounded hover-accent-border hover-accent-text transition-colors">
            GitHub
          </a>
          <a href="https://www.linkedin.com/in/mateo-martinjak-803040197/" target="_blank" class="hud text-[11px] bg-[#15110b] border border-[#3a3122] text-[#ece4d3] px-4 py-2.5 rounded hover-accent-border hover-accent-text transition-colors">
            LinkedIn
          </a>
        </div>
      </section>

      <!-- Stack -->
      <section class="py-16 border-t border-[var(--warm-border)] fade-up">
        <h2 class="hud text-xs text-[#ece4d3] flex items-center gap-2 mb-2">
          <span class="accent-text">[01]</span> Stack
        </h2>

        <ul class="sr-only">
          {stack.map((tech) => <li>{tech.name}</li>)}
        </ul>
        <!-- Each icon's path is defined once here; the marquee items <use> it. -->
        <svg width="0" height="0" class="absolute" aria-hidden="true">
          {Object.entries(stackIcons).map(([id, d]) => (
            <symbol id={`stack-${id}`} viewBox="0 0 24 24"><path d={d} /></symbol>
          ))}
        </svg>
        <div class="stack-marquee -mx-6 md:-mx-10 lg:-mx-16" aria-hidden="true">
          <div class="stack-track" style={`--roll-duration: ${stackDuration}`}>
            {[0, 1].map(() => (
              <div class="stack-group">
                {stackItems.map((tech, i) => (
                  <span class:list={["stack-item", { "is-repeat": i >= stack.length }]}>
                    <svg class="stack-icon"><use href={`#stack-${tech.icon}`} /></svg>
                    {tech.name}
                  </span>
                ))}
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- Experiments -->
      {experiments.length > 0 && (
        <section class="py-16 border-t border-[var(--warm-border)] fade-up">
          <div class="flex items-baseline justify-between mb-8">
            <h2 class="hud text-xs text-[#ece4d3] flex items-center gap-2">
              <span class="accent-text">[02]</span> Experiments
            </h2>
            <a href="/experiments" class="hud text-[11px] accent-text hover:text-white transition-colors">
              All experiments →
            </a>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {experiments.map((experiment, i) => (
              <a
                href={`/experiments/${experiment.id}`}
                class="group block rounded-lg surface hud-card hover-accent-border transition-colors p-6 fade-up"
                style={`transition-delay: ${i * 80}ms`}
              >
                <div class="hud text-[10px] accent-text-dim mb-3">
                  <FormattedDate date={experiment.data.pubDate} />
                </div>
                <h3 class="font-display text-xl text-white mb-2 tracking-wide">
                  {experiment.data.title}
                </h3>
                <p class="text-sm text-[#a89c85] leading-relaxed mb-4">
                  {experiment.data.description}
                </p>
                {experiment.data.tags && (
                  <div class="flex flex-wrap gap-2 mb-4">
                    {experiment.data.tags.map((tag) => (
                      <span class="hud text-[10px] text-[#a89c85] border border-[var(--warm-border-soft)] rounded px-2.5 py-1">
                        {tag}
                      </span>
                    ))}
                  </div>
                )}
                <div class="border-t border-[var(--warm-border-soft)] pt-3 hud text-[11px] accent-text">
                  Open →
                </div>
              </a>
            ))}
          </div>
        </section>
      )}

      <!-- Featured projects -->
      {projects.length > 0 && (
        <section class="py-16 border-t border-[var(--warm-border)] fade-up">
          <div class="flex items-baseline justify-between mb-8">
            <h2 class="hud text-xs text-[#ece4d3] flex items-center gap-2">
              <span class="accent-text">[03]</span> Selected Work
            </h2>
            <a href="/projects" class="hud text-[11px] accent-text hover:text-white transition-colors">
              All projects →
            </a>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {projects.map((project, i) => (
              <a
                href={`/projects/${project.id}`}
                class="group block rounded-lg surface hud-card hover-accent-border transition-colors p-6 fade-up"
                style={`transition-delay: ${i * 80}ms`}
              >
                <h3 class="font-display text-xl text-white mb-2 tracking-wide">
                  {project.data.title}
                </h3>
                <p class="text-sm text-[#a89c85] leading-relaxed">
                  {project.data.description}
                </p>
                <div class="border-t border-[var(--warm-border-soft)] mt-4 pt-3 hud text-[11px] accent-text">
                  Open →
                </div>
              </a>
            ))}
          </div>
        </section>
      )}

      <!-- Contact -->
      <section class="py-16 border-t border-[var(--warm-border)] fade-up">
        <p class="hud accent-text text-[11px] mb-4">[04] Contact</p>
        <h2 class="font-display text-2xl md:text-3xl text-white mb-4 tracking-[0.04em]">
          Got a <span class="accent-text">project</span>?
        </h2>
        <p class="text-base text-[#a89c85] max-w-2xl leading-relaxed">
          I do <span class="accent-text-dim">full-stack</span> work for a living
          and <span class="accent-text-dim">GPU</span> work because I enjoy it.
          If you need help with either, email me.
        </p>
        <a href="mailto:contact@mteo.dev" class="hud text-[11px] inline-flex items-center gap-2 mt-8 bg-[var(--site-accent)] text-[#0a0d14] font-bold px-4 py-2.5 rounded hover:bg-[#fbbf24] transition-colors">
          contact@mteo.dev →
        </a>
      </section>

      <!-- Footer -->
      <footer class="py-8 border-t border-[var(--warm-border)] flex flex-col md:flex-row items-start md:items-center justify-between gap-2 hud text-[10px] text-[#6f6757]">
        <p>Mateo Martinjak · Zagreb, HR</p>
        <p>© {new Date().getFullYear()} mteo.dev</p>
      </footer>
    </div>
    <style>
      /* Bio words come on like a slightly faulty bulb. Most just fade up; a
         few waver once on the way, and one catches late. Each word glows
         faintly amber while it lights, then cools to the body colour. The
         wavers are stepped (no easing) so they read as current, not a fade.
         It all runs in CSS from the first paint: the bio is the largest
         element on mobile, and a JS-started animation would hold back LCP. */
      .flicker-word {
        animation:
          var(--flicker) var(--delay) both,
          word-cool var(--cool) ease-out var(--delay) both;
      }
      .flicker-word[data-flicker="b"] { --flicker: word-fade 0.7s ease-out; --cool: 1.2s; }
      .flicker-word[data-flicker="a"] { --flicker: flicker-a 1s steps(1, end); --cool: 1.5s; }
      .flicker-word[data-flicker="c"] { --flicker: flicker-c 1.6s steps(1, end); --cool: 2.2s; }

      @keyframes word-fade {
        from { opacity: 0; }
      }
      /* One slow, shallow dip, then on. */
      @keyframes flicker-a {
        0%   { opacity: 0; }
        20%  { opacity: 0.85; }
        50%  { opacity: 0.6; }
        75%, 100% { opacity: 1; }
      }
      /* The stubborn one: glows faintly, then catches late. */
      @keyframes flicker-c {
        0%   { opacity: 0; }
        20%  { opacity: 0.3; }
        55%  { opacity: 0.65; }
        80%, 100% { opacity: 1; }
      }
      @keyframes word-cool {
        from {
          color: #e9b54f;
          text-shadow: 0 0 8px rgba(245, 158, 11, 0.35);
        }
      }
      @media (prefers-reduced-motion: reduce) {
        .flicker-word { animation: none; }
      }

      /* Stack marquee. The track holds two identical halves, so sliding it by
         -50% loops seamlessly. Only the transform animates, so it runs on the
         compositor without repainting, leaving the GPU budget to the
         background shader. */
      .stack-marquee {
        --item-gap: 40px;
        overflow: hidden;
        padding-block: 24px;      /* room for the text halo before the clip */
        -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
        mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
      }
      .stack-track {
        display: flex;
        width: max-content;
        animation: stack-roll var(--roll-duration) linear infinite;
      }
      .stack-marquee:hover .stack-track { animation-play-state: paused; }
      .stack-group {
        display: flex;
        gap: var(--item-gap);
        padding-right: var(--item-gap);   /* so the seam between halves matches */
      }
      @keyframes stack-roll {
        to { transform: translateX(-50%); }
      }
      @media (min-width: 768px) {
        .stack-marquee { --item-gap: 56px; }
      }

      .stack-item {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        font-family: var(--font-display);
        font-size: 15px;
        font-weight: 500;
        letter-spacing: 0.02em;
        line-height: 1;
        white-space: nowrap;
        color: rgba(245, 158, 11, 0.6);   /* quiet amber; full on hover */
        /* A layered dark halo keeps the text readable where the fractal is
           still bright. Shadows rasterise once with the moving layer, not per
           frame. */
        text-shadow: 0 0 2px rgba(10, 13, 20, 0.95), 0 0 10px rgba(10, 13, 20, 0.9), 0 0 26px rgba(10, 13, 20, 0.85);
        transition: color 0.2s ease;
      }
      .stack-item:hover { color: #fbbf24; }
      .stack-icon {
        flex: none;
        width: 18px;
        height: 18px;
        fill: currentColor;
        filter: drop-shadow(0 0 2px rgba(10, 13, 20, 0.95)) drop-shadow(0 0 8px rgba(10, 13, 20, 0.9));
      }
      @media (min-width: 768px) {
        .stack-item { font-size: 17px; }
        .stack-icon { width: 19px; height: 19px; }
      }

      /* Reduced motion: a still, wrapped list with each item once. */
      @media (prefers-reduced-motion: reduce) {
        .stack-marquee { margin-inline: 0; padding-block: 16px; -webkit-mask-image: none; mask-image: none; }
        .stack-track { animation: none; width: auto; }
        .stack-group { flex-wrap: wrap; gap: 16px 32px; padding-right: 0; }
        .stack-group + .stack-group,
        .stack-item.is-repeat { display: none; }
      }
    </style>
    <script>
      // Runs on first load AND after every client-side navigation.
      document.addEventListener('astro:page-load', () => {
        // Scroll fade-up via IntersectionObserver
        const observer = new IntersectionObserver((entries) => {
          entries.forEach(e => {
            if (e.isIntersecting) {
              e.target.classList.add('is-visible');
              observer.unobserve(e.target);
            }
          });
        }, { threshold: 0.1 });

        document.querySelectorAll('.fade-up').forEach(el => observer.observe(el));
      });
    </script>
  </body>
</html>
