---
---

<canvas id="world-bg-canvas" transition:persist="world-bg"></canvas>

<style>
  #world-bg-canvas {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    /* The large viewport (mobile URL bar collapsed), so the canvas covers the
       screen however far the bar has slid and never resizes mid-scroll, which
       would re-render and rescale the graphic. 100vh is the fallback. */
    height: 100vh;
    height: 100lvh;
    z-index: 0;
    pointer-events: none;
    display: block;
  }
</style>

<script>
  import worldBgShader from "../shaders/world_bg.ts";

  const VERTEX_SHADER = `
    attribute vec4 aVertexPosition;
    void main() { gl_Position = aVertexPosition; }
  `;

  function loadShader(gl: WebGLRenderingContext, type: number, source: string) {
    const shader = gl.createShader(type);
    if (!shader) return null;
    gl.shaderSource(shader, source);
    gl.compileShader(shader);
    if (!gl.getShaderParameter(shader, gl.COMPILE_STATUS)) {
      console.error("World-bg shader compile error:", gl.getShaderInfoLog(shader));
      gl.deleteShader(shader);
      return null;
    }
    return shader;
  }

  function initProgram(gl: WebGLRenderingContext, vs: string, fs: string) {
    const vert = loadShader(gl, gl.VERTEX_SHADER, vs);
    const frag = loadShader(gl, gl.FRAGMENT_SHADER, fs);
    if (!vert || !frag) return null;
    const program = gl.createProgram()!;
    gl.attachShader(program, vert);
    gl.attachShader(program, frag);
    gl.linkProgram(program);
    if (!gl.getProgramParameter(program, gl.LINK_STATUS)) {
      console.error("World-bg program link error:", gl.getProgramInfoLog(program));
      return null;
    }
    return program;
  }

  // Individual blog posts / notes turn the graphic OFF. The canvas stays
  // (it's transition:persist'd, so we must never destroy it), but we stop
  // the loop and clear it to the page navy — the dot grid + amber edge glow
  // carry the background there instead.
  const graphicOff = () =>
    /^\/(blog|notes|projects|experiments)\/[^/]+/.test(location.pathname);

  // The canvas is transition:persist'd, so it survives client-side navigations.
  // Initialise the WebGL context and render loop exactly once for the whole session.
  function init() {
    if ((window as any).__worldBgInit) return;
    (window as any).__worldBgInit = true;

  const canvas = document.getElementById("world-bg-canvas") as HTMLCanvasElement;
  // A fullscreen quad needs no MSAA, depth or stencil, and an opaque canvas is
  // cheaper for the compositor to blend under the page.
  const gl = canvas?.getContext("webgl", {
    alpha: false,
    antialias: false,
    depth: false,
    stencil: false,
  });

  if (!gl) {
    if (canvas) canvas.style.display = "none";
  } else {
    // An opaque drawing buffer starts out black; show navy until the first frame.
    gl.clearColor(0.039, 0.051, 0.078, 1.0);
    gl.clear(gl.COLOR_BUFFER_BIT);

    const buf = gl.createBuffer();
    gl.bindBuffer(gl.ARRAY_BUFFER, buf);
    gl.bufferData(
      gl.ARRAY_BUFFER,
      new Float32Array([-1, -1, 1, -1, 1, 1, -1, 1]),
      gl.STATIC_DRAW
    );

    const program = initProgram(gl, VERTEX_SHADER, worldBgShader);
    if (program) {
      const aPos   = gl.getAttribLocation(program, "aVertexPosition");
      const uTime  = gl.getUniformLocation(program, "uTime");
      const uRes   = gl.getUniformLocation(program, "uResolution");
      const uShift = gl.getUniformLocation(program, "uShift");
      const uSteps = gl.getUniformLocation(program, "uSteps");
      const uBright = gl.getUniformLocation(program, "uBright");
      const uFocusY = gl.getUniformLocation(program, "uFocusY");
      // Same clock as the rAF timestamps the loop animates with.
      const startTime = performance.now();

      const mq = (q: string) => window.matchMedia(q).matches;
      const mobile = mq("(pointer: coarse)");
      // Phone-width layout — Tailwind's md breakpoint, same as the hero's.
      const narrowMq = window.matchMedia("(max-width: 767px)");

      // Glow brightness by context. On desktop the homepage hero is full and
      // fades down past the fold. At phone width the hero leaves a gap for the
      // graphic, so it shows there, then dims quickly as the bio scrolls over
      // it. Other touch devices (tablets) hold the dim level the whole way.
      // Inner pages are dim everywhere. Recomputed on scroll, resize + each
      // navigation.
      const BRIGHT_TOP   = 1.0;   // homepage hero (desktop only)
      const BRIGHT_FOLD  = 0.3;   // homepage past the fold / tablet homepage
      const BRIGHT_OTHER = 0.3;   // every other page
      const BRIGHT_NARROW_TOP  = 0.5;   // phone-width homepage, graphic in the gap
      const BRIGHT_NARROW_FOLD = 0.18;  // …once the bio has scrolled over it
      let brightness = BRIGHT_TOP;
      const isHome = () =>
        location.pathname === "/" || location.pathname === "/index.html";
      function updateBrightness() {
        if (!isHome()) {
          brightness = BRIGHT_OTHER;
        } else if (narrowMq.matches) {
          const f = Math.min(window.scrollY / (window.innerHeight * 0.3), 1);
          brightness = BRIGHT_NARROW_TOP + (BRIGHT_NARROW_FOLD - BRIGHT_NARROW_TOP) * f;
        } else if (mobile) {
          brightness = BRIGHT_FOLD;            // static dim across the homepage
        } else {
          const f = Math.min(window.scrollY / (window.innerHeight * 0.8), 1);
          brightness = BRIGHT_TOP + (BRIGHT_FOLD - BRIGHT_TOP) * f;
        }
      }

      // ── Quality. GPU cost scales with rendered pixels × march steps, so we
      // render to a pixel budget and let CSS upscale — the glow is soft, so
      // that's essentially invisible. Where the browser exposes GPU timer
      // queries (Chrome/Edge), the budget adapts to measured GPU time and
      // desktop runs at 60fps if the GPU can hold it at a reasonable
      // resolution, else 30. Without timers (Safari, Firefox) we can't measure,
      // so keep the starting budget at a steady 30fps. Phones stay at 30fps to
      // spare the battery.
      const reduceMotion = mq("(prefers-reduced-motion: reduce)");
      const steps = mobile ? 56 : 90;
      const PIXEL_BUDGET = 1_000_000; // rendered pixels, before any measurement
      const MIN_SCALE = 0.4;          // never render below 40% of CSS size
      const GPU_SHARE = 0.55;         // of each frame; the rest composites the page
      const timer = gl.getExtension("EXT_disjoint_timer_query");
      const fpsOptions = mobile || !timer ? [30] : [60, 30];
      let fps = fpsOptions[0];
      let targetPixels = PIXEL_BUDGET;

      // One timer query in flight at a time; its result lands a few frames later.
      let query: WebGLQuery | null = null;
      let queryPixels = 0;
      let samples = 0;
      let msPerPixel = 0;
      let lastAdapt = 0;

      function readQuery(now: number) {
        if (!query || !timer.getQueryObjectEXT(query, timer.QUERY_RESULT_AVAILABLE_EXT)) return;
        const disjoint = gl!.getParameter(timer.GPU_DISJOINT_EXT);
        const ms = timer.getQueryObjectEXT(query, timer.QUERY_RESULT_EXT) / 1e6;
        timer.deleteQueryEXT(query);
        query = null;
        if (!disjoint) adapt(ms / queryPixels, now);
      }

      // Pick the highest frame rate whose GPU budget fits at >= MIN_SCALE,
      // and the pixel count that fills that budget.
      function adapt(sample: number, now: number) {
        if (++samples <= 10) return;   // first frames run slow (warm-up, clocks)
        msPerPixel = msPerPixel ? msPerPixel * 0.8 + sample * 0.2 : sample;
        if (now - lastAdapt < 1000) return;
        lastAdapt = now;

        const cssPixels = canvas.clientWidth * canvas.clientHeight;
        const minPixels = cssPixels * MIN_SCALE * MIN_SCALE;
        let nextFps = fpsOptions[fpsOptions.length - 1];
        let nextPixels = minPixels;
        for (const f of fpsOptions) {
          const px = (GPU_SHARE * 1000) / f / msPerPixel;
          if (px >= minPixels) {
            nextFps = f;
            nextPixels = Math.min(px, cssPixels);
            break;
          }
        }
        // Resizing reallocates the canvas (a one-frame hitch) and GPU clocks
        // make timings wobble ~±15%, so ignore small changes: shrink as soon as
        // we're clearly over budget, grow only with plenty of headroom.
        const ratio = nextPixels / targetPixels;
        if (nextFps !== fps || ratio < 0.85 || ratio > 1.3) {
          fps = nextFps;
          targetPixels = nextPixels;
        }
      }

      // Size the drawing buffer to the pixel target (never above CSS size or
      // below MIN_SCALE); CSS stretches it over the viewport.
      function fitCanvas() {
        const cw = canvas.clientWidth;
        const ch = canvas.clientHeight;
        const s = Math.max(MIN_SCALE, Math.min(1, Math.sqrt(targetPixels / (cw * ch))));
        const w = Math.round(cw * s);
        const h = Math.round(ch * s);
        if (canvas.width !== w || canvas.height !== h) {
          canvas.width = w;
          canvas.height = h;
        }
        gl!.viewport(0, 0, w, h);
      }

      // Camera offset, tweened from `from` -> `to` over a short duration with a
      // fast ease-in/ease-out, so each route change gently reorients the fractal.
      const DURATION = 650;                 // ms — keep it quick
      const cur  = { x: 0, y: 0 };
      const from = { x: 0, y: 0 };
      const to   = { x: 0, y: 0 };
      let tweenStart = -Infinity;

      const easeInOut = (t: number) =>
        t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;

      function relocate() {
        from.x = cur.x;
        from.y = cur.y;
        const angle = Math.random() * Math.PI * 2;
        const dist = 6 + Math.random() * 6;   // small reorientation per nav
        to.x += Math.cos(angle) * dist;
        to.y += Math.sin(angle) * dist;
        tweenStart = performance.now();
      }
      // Vertical placement of the graphic (uv units, + = up). The phone-width
      // homepage hero leaves a gap for it (marked data-world-focus); centre on
      // that gap as it sits at the top of the page. Everywhere else: 0.
      let focusY = 0;
      let lastDrawAt = 0;
      function focusTarget() {
        if (!isHome() || !narrowMq.matches) return 0;
        const gap = document.querySelector("[data-world-focus]");
        if (!gap || !canvas.clientHeight) return 0;
        const r = gap.getBoundingClientRect();
        return 0.5 - (r.top + window.scrollY + r.height / 2) / canvas.clientHeight;
      }

      // Draw exactly one frame at time `now`. `snap` jumps the tween straight to
      // its target (used by the reduced-motion path, which never animates).
      function draw(now: number, snap: boolean) {
        const e = snap ? 1 : easeInOut(Math.min((now - tweenStart) / DURATION, 1));
        cur.x = from.x + (to.x - from.x) * e;
        cur.y = from.y + (to.y - from.y) * e;

        // Glide to a new placement (route change, rotation) rather than jump;
        // the very first frame starts in place.
        const target = focusTarget();
        focusY = snap || !lastDrawAt
          ? target
          : focusY + (target - focusY) * (1 - Math.exp(-(now - lastDrawAt) / 200));
        lastDrawAt = now;

        fitCanvas();

        gl!.clearColor(0.039, 0.051, 0.078, 1.0);
        gl!.clear(gl!.COLOR_BUFFER_BIT);

        gl!.bindBuffer(gl!.ARRAY_BUFFER, buf);
        gl!.vertexAttribPointer(aPos, 2, gl!.FLOAT, false, 0, 0);
        gl!.enableVertexAttribArray(aPos);
        gl!.useProgram(program);

        gl!.uniform1f(uTime, (now - startTime) / 1000);
        gl!.uniform2f(uRes, canvas.width, canvas.height);
        gl!.uniform2f(uShift, cur.x, cur.y);
        gl!.uniform1f(uSteps, steps);
        gl!.uniform1f(uBright, brightness);
        gl!.uniform1f(uFocusY, focusY);

        const timing = timer && !query;
        if (timing) {
          query = timer.createQueryEXT();
          queryPixels = canvas.width * canvas.height;
          timer.beginQueryEXT(timer.TIME_ELAPSED_EXT, query);
        }
        gl!.drawArrays(gl!.TRIANGLE_FAN, 0, 4);
        if (timing) timer.endQueryEXT(timer.TIME_ELAPSED_EXT);
      }

      function clearToNavy() {
        fitCanvas();
        gl!.clearColor(0.039, 0.051, 0.078, 1.0);
        gl!.clear(gl!.COLOR_BUFFER_BIT);
      }

      let rafId = 0;
      let last = 0;
      let looping = false;
      let redrawPending = false;

      const frame = (now: number) => {
        if (!looping) return;
        rafId = requestAnimationFrame(frame);
        if (timer) readQuery(now);
        // Throttle to `fps`. rAF timestamps are coarsened (16.6 / 16.7ms at
        // 60Hz), so a strict `< 1000 / fps` skips a vsync every other frame
        // and judders between 33 and 50ms — allow some slack.
        if (now - last < 1000 / fps - 2) return;
        last = now;
        draw(now, false);
      };
      function startLoop() {
        if (looping) return;
        looping = true;
        last = 0;
        rafId = requestAnimationFrame(frame);
      }
      function stopLoop() {
        looping = false;
        cancelAnimationFrame(rafId);
      }

      // Decide what the background should do for the current route.
      function applyRoute() {
        updateBrightness();
        if (graphicOff()) {
          stopLoop();
          clearToNavy();
        } else if (reduceMotion) {
          stopLoop();
          draw(performance.now(), true);   // one static frame, no loop
        } else {
          startLoop();
        }
      }

      // Homepage brightness also tracks scroll; the static path needs a redraw.
      window.addEventListener("scroll", () => {
        updateBrightness();
        if (reduceMotion && !graphicOff() && !redrawPending) {
          redrawPending = true;
          requestAnimationFrame((now) => { redrawPending = false; draw(now, true); });
        }
      }, { passive: true });
      window.addEventListener("resize", updateBrightness, { passive: true });

      // Pause while the tab is hidden; re-evaluate the route when it returns.
      document.addEventListener("visibilitychange", () => {
        if (document.hidden) stopLoop();
        else applyRoute();
      });

      // Each client-side navigation: reorient, then apply the new route.
      document.addEventListener("astro:after-swap", () => { relocate(); applyRoute(); });

      applyRoute();
    }
  }
  }

  // Creating the WebGL context can block the main and GPU threads for hundreds
  // of ms, so never do it before first contentful paint has been presented,
  // and don't do it at all on routes with the graphic off — the first
  // navigation to a route that shows it does.
  function afterFirstPaint(cb: () => void) {
    const hasFcp = () =>
      performance.getEntriesByName("first-contentful-paint").length > 0;
    if (hasFcp() || !PerformanceObserver.supportedEntryTypes?.includes("paint")) {
      requestAnimationFrame(() => setTimeout(cb, 0));
      return;
    }
    const po = new PerformanceObserver(() => {
      if (!hasFcp()) return;
      po.disconnect();
      setTimeout(cb, 0);
    });
    po.observe({ type: "paint", buffered: true });
  }

  function initWhenNeeded() {
    if (graphicOff()) return;
    document.removeEventListener("astro:after-swap", initWhenNeeded);
    afterFirstPaint(init);
  }
  document.addEventListener("astro:after-swap", initWhenNeeded);
  initWhenNeeded();
</script>
