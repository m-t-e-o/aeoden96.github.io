---
import FormattedDate from "./FormattedDate.astro";

export interface Props {
  url: string;
  title: string;
  pubDate: Date;
  description?: string;
  tags?: string[];
  isFeature?: boolean;
}

const { url, title, pubDate, description, tags, isFeature = false } = Astro.props;
---

<a
  href={url}
  class={`group surface hud-card hover-accent-border transition-colors p-6 flex flex-col justify-between rounded-lg ${isFeature ? "md:col-span-2" : ""}`}
>
  <div>
    <h2 class="font-display text-[#ece4d3] text-2xl tracking-wide mb-2">
      {title}
    </h2>
    <p class="hud text-[#6f6757] text-[10px] mb-4">
      <FormattedDate date={pubDate} />
    </p>
    {description && (
      <p class="text-[#a89c85] text-sm mb-6 leading-relaxed">
        {description}
      </p>
    )}
  </div>

  {tags && tags.length > 0 && (
    <div class="flex flex-wrap gap-2 mt-4">
      {tags.map((tag) => (
        <span class="hud text-[10px] text-[#a89c85] border border-[var(--warm-border-soft)] px-2.5 py-1 rounded transition-colors duration-300">
          {tag}
        </span>
      ))}
    </div>
  )}
</a>
